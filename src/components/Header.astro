---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale, type UIKey } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  /** Current route slug without locale prefix. */
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);

// White logo lives in public/ — prefix with base so it resolves under the sub-path.
const logoSrc = `${import.meta.env.BASE_URL}/logo-white.png`.replace('//', '/');

type NavLeaf = { key: UIKey; slug: string };
type NavItem = NavLeaf & { children?: NavLeaf[] };

const navItems: NavItem[] = [
  { key: 'nav.home', slug: '' },
  {
    key: 'nav.about',
    slug: 'about',
    children: [
      { key: 'nav.overview', slug: 'about' },
      { key: 'nav.ourStory', slug: 'our-story' },
      { key: 'nav.values', slug: 'values' },
      { key: 'nav.whatWeDo', slug: 'what-we-do' },
      { key: 'nav.team', slug: 'team' },
    ],
  },
  { key: 'nav.events', slug: 'events' },
  { key: 'nav.news', slug: 'news' },
  { key: 'nav.getInvolved', slug: 'get-involved' },
  { key: 'nav.contact', slug: 'contact' },
];

const isActive = (slug: string) => slug === path;
const isParentActive = (item: NavItem) =>
  isActive(item.slug) || (item.children?.some((c) => isActive(c.slug)) ?? false);
const url = (slug: string) => getRelativeLocaleUrl(locale, slug);
---

<header class="bg-teal-deep text-white">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3"
  >
    <a
      href={url('')}
      class="flex items-center gap-3 text-white hover:text-white"
    >
      <img
        src={logoSrc}
        alt={t('site.title')}
        width="48"
        height="48"
        class="h-12 w-auto"
      />
      <span class="font-serif text-base leading-tight sm:text-lg">
        {t('site.shortTitle')}
      </span>
    </a>

    <div class="flex items-center gap-6">
      {/* Desktop nav */}
      <nav class="hidden md:block" aria-label="Primary">
        <ul class="flex items-center gap-x-5 text-sm">
          {
            navItems.map((item) =>
              item.children ? (
                <li class="group relative">
                  <a
                    href={url(item.slug)}
                    class:list={[
                      'inline-flex items-center gap-1 text-white/85 hover:text-white',
                      isParentActive(item) &&
                        'border-b-2 border-sage-lt font-semibold text-white',
                    ]}
                    aria-current={isParentActive(item) ? 'page' : undefined}
                  >
                    {t(item.key)}
                    <svg
                      class="h-3 w-3 opacity-80"
                      viewBox="0 0 12 12"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M2.5 4.5 6 8l3.5-3.5"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                  {/* Wrapper carries a transparent pt-2 "bridge" so the gap
                      between the trigger and the panel stays hoverable. */}
                  <div
                    class="invisible absolute left-0 top-full z-20 pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
                  >
                    <ul
                      class="min-w-48 rounded-md bg-white py-2 text-ink shadow-lg ring-1 ring-black/5"
                    >
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={url(child.slug)}
                            class:list={[
                              'block px-4 py-2 hover:bg-bg-warm',
                              isActive(child.slug) &&
                                'font-semibold text-teal-deep',
                            ]}
                            aria-current={isActive(child.slug) ? 'page' : undefined}
                          >
                            {t(child.key)}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              ) : (
                <li>
                  <a
                    href={url(item.slug)}
                    class:list={[
                      'text-white/85 hover:text-white',
                      isActive(item.slug) &&
                        'border-b-2 border-sage-lt font-semibold text-white',
                    ]}
                    aria-current={isActive(item.slug) ? 'page' : undefined}
                  >
                    {t(item.key)}
                  </a>
                </li>
              )
            )
          }
        </ul>
      </nav>

      <div class="hidden md:block">
        <LanguageSwitcher locale={locale} path={path} />
      </div>

      {/* Mobile hamburger */}
      <button
        type="button"
        id="nav-toggle"
        class="md:hidden inline-flex items-center justify-center rounded-md p-2 text-white hover:bg-white/10"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t('nav.menu')}
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile menu panel */}
  <nav
    id="mobile-menu"
    class="hidden border-t border-white/15 md:hidden"
    aria-label="Primary mobile"
  >
    <ul class="mx-auto max-w-6xl px-4 py-3 text-sm">
      {
        navItems.map((item) => (
          <li class="border-b border-white/10 last:border-0">
            <a
              href={url(item.slug)}
              class:list={[
                'block py-2.5 text-white/90 hover:text-white',
                isActive(item.slug) && 'font-semibold text-white',
              ]}
              aria-current={isActive(item.slug) ? 'page' : undefined}
            >
              {t(item.key)}
            </a>
            {item.children && (
              <ul class="pb-2 pl-4">
                {item.children
                  .filter((child) => child.slug !== item.slug)
                  .map((child) => (
                    <li>
                      <a
                        href={url(child.slug)}
                        class:list={[
                          'block py-2 text-white/70 hover:text-white',
                          isActive(child.slug) && 'font-semibold text-white',
                        ]}
                        aria-current={isActive(child.slug) ? 'page' : undefined}
                      >
                        {t(child.key)}
                      </a>
                    </li>
                  ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
    <div class="mx-auto max-w-6xl px-4 pb-4">
      <LanguageSwitcher locale={locale} path={path} />
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
