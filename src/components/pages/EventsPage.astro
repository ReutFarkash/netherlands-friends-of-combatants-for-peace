---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n/ui';
import EventCard from '../EventCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const events = await getCollection('events');

// Build-time "now". Events with a confirmed date in the future are "upcoming";
// everything else (past dates + unconfirmed `dateTbc` recaps) is "past".
const now = new Date();
const isUpcoming = (e: (typeof events)[number]) =>
  !e.data.dateTbc && e.data.date.getTime() >= now.getTime();

const upcoming = events
  .filter(isUpcoming)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const past = events
  .filter((e) => !isUpcoming(e))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout locale={locale} path="events" title={t('events.title')}>
  <h1 class="text-3xl sm:text-4xl">{t('events.title')}</h1>
  <p class="mt-4 max-w-2xl text-lg text-ink/80">{t('events.intro')}</p>

  <section class="mt-10">
    <h2 class="text-2xl">{t('events.upcoming')}</h2>
    {
      upcoming.length === 0 ? (
        <p class="mt-4 text-ink/70">{t('events.empty')}</p>
      ) : (
        <ul class="mt-6 grid gap-6 sm:grid-cols-2">
          {upcoming.map((event) => (
            <EventCard event={event} locale={locale} />
          ))}
        </ul>
      )
    }
  </section>

  {
    past.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl">{t('events.past')}</h2>
        <ul class="mt-6 grid gap-6 sm:grid-cols-2">
          {past.map((event) => (
            <EventCard event={event} locale={locale} />
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
