---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const email = 'nlcfpfriends@gmail.com';
const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/nlfcfpeace' },
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/people/Netherlands-friends-of-CfP/61587000159046/',
  },
  { label: 'Linktree', href: 'https://linktr.ee/nlfcfp' },
];
---

<BaseLayout locale={locale} path="contact" title={t('contact.title')}>
  <article class="mx-auto max-w-2xl">
    <h1 class="text-3xl sm:text-4xl">{t('contact.title')}</h1>
    <p class="mt-4 text-lg text-ink/80">{t('contact.intro')}</p>

    <div class="mt-8">
      <h2 class="text-lg">{t('contact.emailLabel')}</h2>
      <a class="text-teal-deep" href={`mailto:${email}`}>{email}</a>
    </div>

    <div class="mt-8">
      <h2 class="text-lg">{t('contact.followLabel')}</h2>
      <ul class="mt-2 flex flex-wrap gap-4">
        {
          socials.map((s) => (
            <li>
              <a
                class="text-teal-deep underline"
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </article>
</BaseLayout>
