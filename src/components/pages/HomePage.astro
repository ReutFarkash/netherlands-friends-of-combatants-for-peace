---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const donateUrl =
  'https://payment-links.mollie.com/en/payment/9Ytth7uKvNipqJVyV7gFj/details';
const subscribeUrl = `${getRelativeLocaleUrl(locale, 'get-involved')}#subscribe`;
const logoSrc = `${import.meta.env.BASE_URL}/logo-teal.png`.replace('//', '/');
---

<BaseLayout locale={locale} path="">
  <section class="flex flex-col items-center gap-6 py-8 text-center">
    <img
      src={logoSrc}
      alt={t('site.title')}
      width="160"
      height="160"
      class="h-32 w-auto sm:h-40"
    />
    <h1 class="max-w-3xl text-3xl sm:text-4xl">{t('site.title')}</h1>
    <p class="max-w-2xl text-lg text-ink/80">{t('home.mission')}</p>

    <div class="mt-2 flex flex-wrap items-center justify-center gap-4">
      <a
        href={donateUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-teal-deep px-6 py-3 font-semibold text-white no-underline hover:bg-teal"
      >
        {t('cta.donate')}
      </a>
      <a
        href={subscribeUrl}
        class="rounded-md border-2 border-teal-deep px-6 py-3 font-semibold text-teal-deep no-underline hover:bg-teal-deep hover:text-white"
      >
        {t('cta.subscribe')}
      </a>
    </div>
  </section>
</BaseLayout>
