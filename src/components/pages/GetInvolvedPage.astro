---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prov from '../Prov.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const donateUrl =
  'https://payment-links.mollie.com/en/payment/9Ytth7uKvNipqJVyV7gFj/details';

// Interim: link to the chapter's existing MailerLite ("Mailerpage") signup so
// new sign-ups flow into their current list — no migration, no lost subscribers.
// Upgrade to a styled inline embed once Roni shares MailerLite account access.
const subscribeUrl =
  'https://netherlands-friends-of-combatants-for-peace-glujvh.mailerpage.io/subscribe';
const instagramUrl = 'https://www.instagram.com/nlfcfpeace';

const cardClass = 'rounded-lg border border-sage/30 bg-white p-6';
const btnPrimary =
  'mt-4 inline-block rounded-md bg-teal-deep px-6 py-3 font-semibold text-white no-underline hover:bg-teal';
const btnOutline =
  'mt-4 inline-block rounded-md border-2 border-teal-deep px-6 py-3 font-semibold text-teal-deep no-underline hover:bg-teal-deep hover:text-white';
---

<BaseLayout locale={locale} path="get-involved" title={t('involved.title')}>
  <h1 class="text-3xl sm:text-4xl">{t('involved.title')}</h1>
  <p class="mt-4 max-w-2xl text-lg text-ink/80">
    {t('involved.lead')}<Prov type="ai" />
  </p>

  <div class="mt-8 grid gap-8 md:grid-cols-2">
    <section id="subscribe" class={cardClass}>
      <h2 class="text-2xl">{t('involved.subscribe.title')}</h2>
      <p class="mt-3 text-ink/80">{t('involved.subscribe.body')}<Prov type="ai" /></p>
      <a href={subscribeUrl} target="_blank" rel="noopener noreferrer" class={btnPrimary}>
        {t('cta.subscribe')}
      </a>
    </section>

    <section id="donate" class={cardClass}>
      <h2 class="text-2xl">{t('involved.donate.title')}</h2>
      <p class="mt-3 text-ink/80">
        {t('involved.donate.body')}<Prov type="tbc" note="confirm the Mollie donation link goes to the chapter" />
      </p>
      <a href={donateUrl} target="_blank" rel="noopener noreferrer" class={btnPrimary}>
        {t('cta.donate')}
      </a>
    </section>

    <section class={cardClass}>
      <h2 class="text-2xl">{t('involved.attend.title')}</h2>
      <p class="mt-3 text-ink/80">{t('involved.attend.body')}<Prov type="ai" /></p>
      <a href={getRelativeLocaleUrl(locale, 'events')} class={btnOutline}>
        {t('involved.attend.cta')}
      </a>
    </section>

    <section class={cardClass}>
      <h2 class="text-2xl">{t('involved.follow.title')}</h2>
      <p class="mt-3 text-ink/80">{t('involved.follow.body')}<Prov type="ai" /></p>
      <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class={btnOutline}>
        {t('home.instagram.cta')}
      </a>
    </section>
  </div>
</BaseLayout>
