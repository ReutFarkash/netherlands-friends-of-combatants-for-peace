---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const donateUrl =
  'https://payment-links.mollie.com/en/payment/9Ytth7uKvNipqJVyV7gFj/details';

// Interim: link to the chapter's existing MailerLite ("Mailerpage") signup so
// new sign-ups flow into their current list — no migration, no lost subscribers.
// Upgrade to a styled inline embed once Roni shares MailerLite account access.
const subscribeUrl =
  'https://netherlands-friends-of-combatants-for-peace-glujvh.mailerpage.io/subscribe';
---

<BaseLayout locale={locale} path="get-involved" title={t('involved.title')}>
  <h1 class="text-3xl sm:text-4xl">{t('involved.title')}</h1>

  <div class="mt-8 grid gap-8 md:grid-cols-2">
    <section id="subscribe" class="rounded-lg border border-sage/30 bg-white p-6">
      <h2 class="text-2xl">{t('involved.subscribe.title')}</h2>
      <p class="mt-3 text-ink/80">{t('involved.subscribe.body')}</p>

      <a
        href={subscribeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-block rounded-md bg-teal-deep px-6 py-3 font-semibold text-white no-underline hover:bg-teal"
      >
        {t('cta.subscribe')}
      </a>
    </section>

    <section id="donate" class="rounded-lg border border-sage/30 bg-white p-6">
      <h2 class="text-2xl">{t('involved.donate.title')}</h2>
      <p class="mt-3 text-ink/80">{t('involved.donate.body')}</p>
      <a
        href={donateUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-block rounded-md bg-teal-deep px-6 py-3 font-semibold text-white no-underline hover:bg-teal"
      >
        {t('cta.donate')}
      </a>
    </section>
  </div>
</BaseLayout>
