---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  event: CollectionEntry<'events'>;
  locale: Locale;
}

const { event, locale } = Astro.props;
const t = useTranslations(locale);
const { title, date, dateTbc, location, description, link, image, imageAlt } =
  event.data;

const dateFormatter = new Intl.DateTimeFormat(locale === 'nl' ? 'nl-NL' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const hasImage = Boolean(image);
const imgClass = 'h-48 w-full object-cover sm:h-full';
---

<li
  class:list={[
    'overflow-hidden rounded-lg border border-sage/30 bg-white shadow-sm',
    hasImage && 'grid sm:grid-cols-2',
  ]}
>
  {
    hasImage &&
      (link ? (
        <a href={link} target="_blank" rel="noopener noreferrer" class="block">
          <img src={image} alt={imageAlt ?? title} loading="lazy" class={imgClass} />
        </a>
      ) : (
        <img src={image} alt={imageAlt ?? title} loading="lazy" class={imgClass} />
      ))
  }

  <div class="p-6">
    {
      dateTbc ? (
        <span class="text-sm font-semibold uppercase tracking-wide text-brown">
          {t('events.dateTbc')}
        </span>
      ) : (
        <time
          datetime={date.toISOString()}
          class="text-sm font-semibold uppercase tracking-wide text-teal"
        >
          {dateFormatter.format(date)}
        </time>
      )
    }
    <h3 class="mt-2 text-xl">{title}</h3>
    <p class="mt-1 text-sm text-brown">
      {t('events.locationLabel')}: {location}
    </p>
    <p class="mt-3 text-ink/80">{description}</p>
    {
      link && (
        <a
          class="mt-3 inline-block font-semibold text-teal-deep"
          href={link}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t('events.details')} →
        </a>
      )
    }
  </div>
</li>
