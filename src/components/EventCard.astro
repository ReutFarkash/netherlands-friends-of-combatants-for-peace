---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  event: CollectionEntry<'events'>;
  locale: Locale;
}

const { event, locale } = Astro.props;
const t = useTranslations(locale);

const dateFormatter = new Intl.DateTimeFormat(locale === 'nl' ? 'nl-NL' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<li class="rounded-lg border border-sage/30 bg-white p-6 shadow-sm">
  {
    event.data.dateTbc ? (
      <span class="text-sm font-semibold uppercase tracking-wide text-brown">
        {t('events.dateTbc')}
      </span>
    ) : (
      <time
        datetime={event.data.date.toISOString()}
        class="text-sm font-semibold uppercase tracking-wide text-teal"
      >
        {dateFormatter.format(event.data.date)}
      </time>
    )
  }
  <h3 class="mt-2 text-xl">{event.data.title}</h3>
  <p class="mt-1 text-sm text-brown">
    {t('events.locationLabel')}: {event.data.location}
  </p>
  <p class="mt-3 text-ink/80">{event.data.description}</p>
  {
    event.data.link && (
      <a
        class="mt-3 inline-block font-semibold text-teal-deep"
        href={event.data.link}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('events.details')} →
      </a>
    )
  }
</li>
