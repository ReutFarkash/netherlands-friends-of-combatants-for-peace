---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const email = 'nlcfpfriends@gmail.com';
const contactUrl = getRelativeLocaleUrl(locale, 'contact');
// Internal anchor to the Donate card — avoids a fourth, unconfirmed external
// money link in the footer. Swap to the direct donation URL once Roni confirms
// the account (currently a Mollie link under "Sivmo", not verified as CfP-NL's).
const donateUrl = `${getRelativeLocaleUrl(locale, 'get-involved')}#donate`;

const btnSolid =
  'inline-block rounded-md bg-white px-5 py-2.5 font-semibold text-teal-deep no-underline hover:bg-sage-lt';
const btnGhost =
  'inline-block rounded-md border-2 border-white/70 px-5 py-2.5 font-semibold text-white no-underline hover:bg-white hover:text-teal-deep';
---

<footer class="mt-16 bg-teal-deep text-white">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="flex flex-col gap-6 sm:flex-row sm:justify-between">
      <div>
        <p class="font-serif text-lg text-white">{t('site.title')}</p>
        <p class="mt-2 max-w-md text-sm text-white/75">
          {t('footer.affiliation')}
        </p>

        {/* Primary calls to action: Contact + Donate */}
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={contactUrl} class={btnGhost}>{t('nav.contact')}</a>
          <a href={donateUrl} class={btnSolid}>{t('cta.donate')}</a>
        </div>
      </div>

      <nav aria-label="Social and contact" class="text-sm">
        <ul class="flex flex-col gap-3">
          <li>
            <span class="text-white/60">{t('contact.emailLabel')}:</span>{' '}
            <a class="text-white underline hover:text-sage-lt" href={`mailto:${email}`}>
              {email}
            </a>
          </li>

          {/* Social platforms as logo links */}
          <li>
            <ul class="flex items-center gap-4">
              <li>
                <a
                  class="inline-flex text-white hover:text-sage-lt"
                  href="https://www.instagram.com/nlfcfpeace"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Instagram"
                >
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path
                      d="M7.03.084c-1.277.06-2.149.264-2.911.563-.79.308-1.458.72-2.123 1.388S.766 3.796.46 4.586c-.295.764-.496 1.637-.552 2.914C-.148 8.775-.16 9.186-.154 12.445c.006 3.259.02 3.667.083 4.947.06 1.277.264 2.148.563 2.911.308.789.72 1.457 1.388 2.123.668.665 1.337 1.074 2.129 1.38.762.295 1.635.496 2.913.552 1.278.056 1.688.069 4.946.063 3.258-.006 3.668-.02 4.948-.081 1.28-.061 2.147-.265 2.91-.563.789-.309 1.458-.72 2.123-1.388.665-.668 1.074-1.338 1.38-2.128.295-.763.496-1.636.55-2.912.057-1.281.07-1.69.063-4.948-.006-3.258-.021-3.667-.082-4.947-.06-1.28-.264-2.149-.563-2.912-.308-.789-.72-1.457-1.388-2.123C21.204.792 20.536.383 19.746.077 18.983-.218 18.11-.42 16.833-.474 15.556-.53 15.146-.543 11.887-.537 8.628-.531 8.22-.516 6.94-.453zM6.9 21.783c-1.17-.05-1.805-.245-2.228-.408-.56-.216-.96-.475-1.381-.893-.421-.417-.68-.818-.898-1.376-.164-.423-.362-1.056-.417-2.227-.06-1.264-.072-1.644-.079-4.848-.007-3.203.005-3.582.06-4.848.05-1.169.246-1.805.408-2.227.216-.561.475-.96.893-1.382.417-.421.818-.68 1.376-.898.423-.164 1.056-.36 2.226-.417 1.265-.06 1.645-.072 4.848-.08 3.203-.006 3.583.006 4.849.061 1.169.05 1.805.245 2.227.408.56.216.96.474 1.382.893.421.418.68.817.898 1.376.164.421.36 1.055.417 2.225.06 1.265.073 1.645.08 4.848.006 3.204-.006 3.583-.061 4.848-.05 1.17-.245 1.806-.408 2.229-.216.56-.475.96-.893 1.381-.418.422-.818.68-1.376.898-.421.164-1.056.361-2.226.417-1.265.06-1.645.073-4.849.08-3.203.007-3.582-.006-4.848-.06M16.953 5.586a1.44 1.44 0 1 0 2.881-.001 1.44 1.44 0 0 0-2.881.001M5.838 12.012a6.161 6.161 0 1 0 12.323-.024 6.161 6.161 0 0 0-12.323.024M8 12.008a4 4 0 1 1 8-.016 4 4 0 0 1-8 .016"
                    ></path>
                  </svg>
                </a>
              </li>
              <li>
                <a
                  class="inline-flex text-white hover:text-sage-lt"
                  href="https://www.facebook.com/people/Netherlands-friends-of-CfP/61587000159046/"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Facebook"
                >
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path
                      d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647z"
                    ></path>
                  </svg>
                </a>
              </li>
            </ul>
          </li>

          <li>
            <a
              class="text-white underline hover:text-sage-lt"
              href="https://linktr.ee/nlfcfp"
              target="_blank"
              rel="noopener noreferrer"
            >
              Linktree
            </a>
          </li>

          <li>
            <span class="text-white/60">{t('footer.parentMovement')}:</span>{' '}
            <a
              class="text-white underline hover:text-sage-lt"
              href="https://www.cfpeace.org/"
              target="_blank"
              rel="noopener noreferrer"
            >
              cfpeace.org
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div
      class="mt-8 flex flex-col gap-2 border-t border-white/15 pt-4 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {new Date().getFullYear()} {t('site.title')}.</p>
      <p class="flex items-center gap-2">
        <span>{t('footer.credit')} Reut Farkash</span>
        <a
          class="text-white/50 hover:text-sage-lt"
          href="https://github.com/ReutFarkash"
          target="_blank"
          rel="noopener"
          aria-label="Reut Farkash on GitHub"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02 0 2.05.14 3 .4 2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.92 1.23 3.23 0 4.62-2.8 5.64-5.48 5.94.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.28 0 .32.21.7.82.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"
            ></path>
          </svg>
        </a>
        <a
          class="text-white/50 hover:text-sage-lt"
          href="https://x.com/ReutFarkash"
          target="_blank"
          rel="noopener"
          aria-label="Reut Farkash on Twitter"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M23.954 4.569a10 10 0 0 1-2.825.775 4.958 4.958 0 0 0 2.163-2.723 9.99 9.99 0 0 1-3.127 1.195 4.92 4.92 0 0 0-8.384 4.482A13.969 13.969 0 0 1 1.671 3.149a4.93 4.93 0 0 0 1.523 6.574 4.903 4.903 0 0 1-2.229-.616v.061a4.926 4.926 0 0 0 3.946 4.827 4.996 4.996 0 0 1-2.224.084 4.93 4.93 0 0 0 4.6 3.419A9.879 9.879 0 0 1 0 19.54a13.94 13.94 0 0 0 7.548 2.212c9.057 0 14.01-7.503 14.01-14.01 0-.213-.005-.426-.014-.637A10.012 10.012 0 0 0 24 4.59l-.046-.021z"
            ></path>
          </svg>
        </a>
      </p>
    </div>
  </div>
</footer>
