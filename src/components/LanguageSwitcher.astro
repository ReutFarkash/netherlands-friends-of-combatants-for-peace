---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, type Locale } from '../i18n/ui';

interface Props {
  /** Current locale. */
  locale: Locale;
  /** Route slug without locale prefix, e.g. '' | 'about' | 'events'. */
  path: string;
}

const { locale, path } = Astro.props;
const locales = Object.keys(languages) as Locale[];

// Compact switcher labels. EN/NL use their Latin codes; HE uses the standard
// Israeli short form עב. AR keeps the full native name for now — its short form
// is an open question pending a native Arabic speaker (see content-provenance).
// Full names stay available via the `title`/aria for accessibility.
const shortLabels: Record<Locale, string> = {
  en: 'EN',
  nl: 'NL',
  he: 'עב',
  ar: 'العربية',
};
---

<nav class="flex items-center gap-2 text-sm" aria-label="Language">
  {
    locales.map((loc, i) => (
      <>
        {i > 0 && <span aria-hidden="true" class="text-white/40">|</span>}
        {loc === locale ? (
          <span
            class="font-semibold text-white"
            aria-current="true"
            lang={loc}
            title={languages[loc]}
          >
            {shortLabels[loc]}
          </span>
        ) : (
          <a
            class="text-white/80 hover:text-white"
            href={getRelativeLocaleUrl(loc, path)}
            hreflang={loc}
            lang={loc}
            title={languages[loc]}
          >
            {shortLabels[loc]}
          </a>
        )}
      </>
    ))
  }
</nav>
