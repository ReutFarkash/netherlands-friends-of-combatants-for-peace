---
// Option A — "Two Voices": two fields side by side (teal | warm) meeting on a
// seam, making the binational "side by side" literal. Stacks on mobile.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const donateUrl =
  'https://payment-links.mollie.com/en/payment/9Ytth7uKvNipqJVyV7gFj/details';
const subscribeUrl = `${getRelativeLocaleUrl(locale, 'get-involved')}#subscribe`;
---

<section class="grid overflow-hidden rounded-2xl shadow-sm md:grid-cols-2">
  <div class="flex flex-col justify-center bg-teal-deep px-8 py-12 text-white sm:px-10 sm:py-16">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sage-lt">
      {t('home.hero.eyebrow')}
    </p>
    <h1 class="mt-4 text-balance text-3xl font-black leading-[1.1] text-white sm:text-4xl">
      {t('home.hero.headline')}
    </h1>
  </div>

  <div class="flex flex-col justify-center border-t-4 border-sage-lt bg-bg-warm px-8 py-12 text-ink md:border-l-4 md:border-t-0 sm:px-10">
    <p class="max-w-md text-base leading-relaxed text-ink/80">
      {t('home.mission')}
    </p>
    <div class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-3">
      <a
        href={donateUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-teal-deep px-6 py-3 font-semibold text-white no-underline hover:bg-teal"
      >
        {t('cta.donate')}
      </a>
      <a
        href={subscribeUrl}
        class="group inline-flex items-center gap-2 font-semibold text-teal-deep no-underline"
      >
        <span class="group-hover:underline">{t('cta.subscribe')}</span>
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</section>
