---
// DEV GALLERY — internal index of every design preview, for chapter review from
// a single URL. Not linked from the public nav (only from the dev banner).
// Not the final site.
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    group: 'Homepage hero directions',
    items: [
      { title: 'Common Ground', href: '/preview/common-ground', desc: 'Two-field hero (teal/warm) meeting on a seam — the binational idea made literal. The most developed redesign.' },
      { title: 'Photo-led', href: '/preview/photo', desc: 'Full-bleed photo hero + wayfinding cards. Image is a CC0 olive-grove placeholder (final needs a chapter-owned photo).' },
      { title: 'Two Voices', href: '/preview/voices', desc: 'Split hero (two columns side by side) + wayfinding cards. Full homepage.' },
    ],
  },
  {
    group: 'Hero styles (isolated)',
    items: [
      { title: 'Two Voices — hero only', href: '/preview/split', desc: 'The split hero on its own.' },
      { title: 'Quiet Statement', href: '/preview/statement', desc: 'Typographic manifesto — oversized headline, restrained, cool ground.' },
      { title: 'Action Hub', href: '/preview/hub', desc: 'Compact banner + About / Events / Subscribe cards.' },
    ],
  },
  {
    group: 'Current site',
    items: [
      { title: 'Live homepage (baseline)', href: '/', desc: 'The current EN/NL homepage — what is deployed today.' },
      { title: 'Dutch homepage', href: '/nl', desc: 'Same site in Dutch.' },
    ],
  },
];
---

<BaseLayout locale="en" path="" title="Design previews (dev)">
  <section class="py-4">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brown">In development</p>
    <h1 class="mt-2 text-3xl text-teal-deep sm:text-4xl">Design previews</h1>
    <p class="mt-3 max-w-2xl text-ink/75">
      Work-in-progress homepage directions for the NLFCFP site, gathered here so they can be
      compared from one link. These are drafts for review — not the final site. Copy, images
      and layout are all still being decided.
    </p>

    {
      sections.map((s) => (
        <div class="mt-10">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-sage">{s.group}</h2>
          <div class="mt-4 grid gap-5 md:grid-cols-3">
            {s.items.map((it) => (
              <a
                href={it.href}
                class="group flex flex-col rounded-xl border border-sage/40 bg-bg-warm p-6 no-underline transition-colors hover:border-teal"
              >
                <h3 class="text-lg text-teal-deep">{it.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/75">{it.desc}</p>
                <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-teal-deep">
                  <span class="group-hover:underline">Open preview</span>
                  <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))
    }

    <p class="mt-10 rounded-lg border border-brown/25 bg-bg-warm p-4 text-sm text-ink/70">
      A Hebrew + Arabic (RTL) multilingual draft also exists on a separate branch
      (AI machine-translation, pending native-speaker review). Ask Reut for that link if you'd
      like to see the 4-language idea.
    </p>
  </section>
</BaseLayout>
