---
// DEV GALLERY — internal index of every design preview + content draft, for
// chapter review from a single URL. Not linked from the public nav (only from
// the dev banner). Not the final site.
//
// Thumbnails are generated by scripts/screenshots.mjs → public/previews/*.png.
// Re-run that script after changing a preview.
import BaseLayout from '../layouts/BaseLayout.astro';

const thumb = (name: string) =>
  `${import.meta.env.BASE_URL}/previews/${name}.png`.replace('//', '/');

const sections = [
  {
    group: 'Homepage hero directions',
    items: [
      { title: 'Common Ground', href: '/preview/common-ground', img: 'common-ground', desc: 'Two-field hero (teal/warm) meeting on a seam — the binational idea made literal. The most developed redesign.' },
      { title: 'Photo-led', href: '/preview/photo', img: 'photo', desc: 'Full-bleed photo hero + wayfinding cards. Image is a CC0 olive-grove placeholder (final needs a chapter-owned photo).' },
      { title: 'Two Voices', href: '/preview/voices', img: 'voices', desc: 'Split hero (two columns side by side) + wayfinding cards. Full homepage.' },
    ],
  },
  {
    group: 'Hero styles (isolated)',
    items: [
      { title: 'Two Voices — hero only', href: '/preview/split', img: 'split', desc: 'The split hero on its own.' },
      { title: 'Quiet Statement', href: '/preview/statement', img: 'statement', desc: 'Typographic manifesto — oversized headline, restrained, cool ground.' },
      { title: 'Action Hub', href: '/preview/hub', img: 'hub', desc: 'Compact banner + About / Events / Subscribe cards.' },
    ],
  },
  {
    group: 'Current site',
    items: [
      { title: 'Live homepage (baseline)', href: '/', img: 'home', desc: 'The current EN/NL homepage — what is deployed today.' },
      { title: 'Dutch homepage', href: '/nl', img: 'home-nl', desc: 'Same site in Dutch.' },
    ],
  },
  {
    group: 'Content-page drafts',
    items: [
      { title: 'About', href: '/about', img: 'about', desc: 'Who CfP is + the NL chapter. Grounded in the org doc.' },
      { title: 'Our Story', href: '/our-story', img: 'our-story', desc: 'Founding narrative (2005–06). Sourced from Wikipedia + org doc.' },
      { title: 'Our Values', href: '/values', img: 'values', desc: 'The movement’s own six values.' },
      { title: 'What We Do', href: '/what-we-do', img: 'what-we-do', desc: 'Ceremonies, education, ground work, advocacy.' },
      { title: 'Get Involved', href: '/get-involved', img: 'get-involved', desc: 'Subscribe, donate, attend, follow.' },
      { title: 'Contact', href: '/contact', img: 'contact', desc: 'Warmer intro + the chapter’s channels.' },
      { title: 'Team', href: '/team', img: 'team', desc: 'Labelled placeholder — needs the chapter’s members.' },
      { title: 'News', href: '/news', img: 'news', desc: 'Instagram-fed, no manual upkeep.' },
    ],
  },
];
---

<BaseLayout locale="en" path="" title="Design previews (dev)">
  <section class="py-4">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brown">In development</p>
    <h1 class="mt-2 text-3xl text-teal-deep sm:text-4xl">Design &amp; content previews</h1>
    <p class="mt-3 max-w-2xl text-ink/75">
      Work-in-progress for the NLFCFP site, gathered here so it can be reviewed from one link.
      These are drafts — not the final site. Copy, images and layout are all still being decided.
    </p>
    <p class="mt-3 max-w-2xl text-sm text-ink/60">
      Tip: the site defaults to a clean <strong>Public</strong> view. Flip the
      <strong>Dev / Public</strong> toggle (bottom-right) to <strong>Dev</strong> to reveal the
      review wrapper — the banner plus a source tag on every piece of copy (AI-written,
      AI-translated, the chapter’s own doc, or Wikipedia).
    </p>

    {
      sections.map((s) => (
        <div class="mt-10">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-sage">{s.group}</h2>
          <div class="mt-4 grid gap-5 sm:grid-cols-2 md:grid-cols-3">
            {s.items.map((it) => (
              <a
                href={it.href}
                class="group flex flex-col overflow-hidden rounded-xl border border-sage/40 bg-bg-warm no-underline transition-colors hover:border-teal"
              >
                <img
                  src={thumb(it.img)}
                  alt={`Preview of ${it.title}`}
                  width="640"
                  height="453"
                  loading="lazy"
                  class="aspect-[640/453] w-full border-b border-sage/30 bg-white object-cover object-top"
                />
                <div class="flex flex-1 flex-col p-5">
                  <h3 class="text-lg text-teal-deep">{it.title}</h3>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/75">{it.desc}</p>
                  <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-teal-deep">
                    <span class="group-hover:underline">Open</span>
                    <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))
    }

    <p class="mt-10 rounded-lg border border-brown/25 bg-bg-warm p-4 text-sm text-ink/70">
      A Hebrew + Arabic (RTL) multilingual draft also exists on a separate branch
      (AI machine-translation, pending native-speaker review). Ask Reut for that link if you'd
      like to see the 4-language idea.
    </p>
  </section>
</BaseLayout>
