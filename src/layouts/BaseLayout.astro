---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Route slug without locale prefix, e.g. '' | 'about' | 'events'. */
  path: string;
  title?: string;
  description?: string;
}

const { locale, path, title, description } = Astro.props;
const t = useTranslations(locale);

const pageTitle = title ? `${title} — ${t('site.title')}` : t('site.title');
const metaDescription = description ?? t('home.mission');
const faviconHref = `${import.meta.env.BASE_URL}/logo-teal.png`.replace('//', '/');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={faviconHref} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    {/* Apply Dev/Public preference before paint (no flash). Default = Public. */}
    <script is:inline>
      if (localStorage.getItem('nlfcfp-dev') === '1')
        document.documentElement.classList.add('dev-on');
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    {/* Dev wrapper — shown only in Dev view (the `dev-only` class). The default
        public view hides all of this; the corner toggle switches modes. */}
    <div class="dev-only flex flex-wrap items-center justify-center gap-x-3 gap-y-1 bg-amber-400 px-4 py-2 text-center text-sm text-ink">
      <span>
        🚧 <strong>Development preview</strong> — drafts for review, not the final site.
      </span>
      <a href={`${import.meta.env.BASE_URL}/dev`.replace('//', '/')} class="font-semibold text-ink underline">
        View all previews →
      </a>
    </div>
    {
      locale !== 'en' && (
        <div class="dev-only bg-violet-100 px-4 py-2 text-center text-sm text-violet-900">
          🌐 This page is an AI machine-translation — pending native review.
        </div>
      )
    }
    <Header locale={locale} path={path} />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-10">
      <slot />
    </main>
    <Footer locale={locale} />

    {/* Dev/Public toggle — always reachable (even when the dev banner is hidden).
        Whole control is removed at launch along with the rest of the dev wrapper. */}
    <div
      class="fixed bottom-3 right-3 z-50 flex overflow-hidden rounded-full border border-ink/20 bg-white/95 text-xs font-semibold shadow-md backdrop-blur"
      role="group"
      aria-label="Dev / Public view"
    >
      <button type="button" data-dev-mode="dev" class="px-3 py-1.5 transition-colors">Dev</button>
      <button type="button" data-dev-mode="public" class="px-3 py-1.5 transition-colors">Public</button>
    </div>
    <script is:inline>
      document.querySelectorAll('[data-dev-mode]').forEach((b) => {
        b.addEventListener('click', () => {
          const dev = b.getAttribute('data-dev-mode') === 'dev';
          document.documentElement.classList.toggle('dev-on', dev);
          localStorage.setItem('nlfcfp-dev', dev ? '1' : '0');
        });
      });
    </script>
  </body>
</html>
