---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, isRtl, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Route slug without locale prefix, e.g. '' | 'about' | 'events'. */
  path: string;
  title?: string;
  description?: string;
}

const { locale, path, title, description } = Astro.props;
const t = useTranslations(locale);

const pageTitle = title ? `${title} — ${t('site.title')}` : t('site.title');
const metaDescription = description ?? t('home.mission');
const faviconHref = `${import.meta.env.BASE_URL}/logo-teal.png`.replace('//', '/');
---

<!doctype html>
<html lang={locale} dir={isRtl(locale) ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={faviconHref} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header locale={locale} path={path} />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-10">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
