# Instagram feed (Behold). Leave blank to show the "Follow on Instagram" fallback.
# Get the feed ID from app.behold.so after connecting @nlfcfpeace and creating a
# Widget feed. Set the real value in .env locally and in Cloudflare build variables.
PUBLIC_BEHOLD_FEED_ID=

# Cloudflare Web Analytics (privacy-first, cookieless — no consent banner needed).
# Leave blank to disable (e.g. during the gated preview). To switch on:
#   Cloudflare dash → Analytics & Logs → Web Analytics → Add a site →
#   copy the token from the snippet → set it here / in Cloudflare build variables.
PUBLIC_CF_ANALYTICS_TOKEN=
